[gd_resource type="Resource" script_class="CardData" load_steps=4 format=3]

[ext_resource type="Script" path="res://data/CardData.gd" id="1_carddata"]
[ext_resource type="Script" path="res://data/EffectData.gd" id="2_effectdata"]

[sub_resource type="Resource" id="EffectData_1" script_class="EffectData"]
script = ExtResource("2_effectdata")
effect_type = "add_curse_to_hand"
params = {"is_temporary": true}

[sub_resource type="Resource" id="EffectData_2" script_class="EffectData"]
script = ExtResource("2_effectdata")
effect_type = "damage_per_curse_in_hand"
params = {"base_amount": 0, "per_curse": 6}

[resource]
script = ExtResource("1_carddata")
id = "hex"
name = "Hex"
cost = 1
rarity = 1
card_type = 0
targeting_mode = 1
owner_character_id = "witch"
base_effects = [SubResource("EffectData_1"), SubResource("EffectData_2")]
