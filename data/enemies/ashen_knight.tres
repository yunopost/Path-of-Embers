"id": "move_1",
"telegraph_text": "Blade Rush 16x2",
"timer": 6
}, {
"effects": [SubResource("EffectData_2")],
"id": "move_2",
"telegraph_text": "Ash Cloud",
"timer": 3
}, {
"effects": [SubResource("EffectData_3")],
"id": "move_3",
"telegraph_text": "Charged Strike 26",
"timer": 8
}, {
